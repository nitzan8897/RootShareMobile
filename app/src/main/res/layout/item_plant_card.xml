<?xml version="1.0" encoding="utf-8"?>
<!--
    Featured plant card — displayed in the horizontal RecyclerView on the Home screen.
    Fixed width so cards scroll horizontally.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="140dp"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/gray_200"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Plant image -->
        <ImageView
            android:id="@+id/image_plant"
            android:layout_width="0dp"
            android:layout_height="120dp"
            android:scaleType="centerCrop"
            android:contentDescription="@string/cd_plant_image"
            android:background="@color/gray_100"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Status badge -->
        <TextView
            android:id="@+id/text_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/emerald_500"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            app:layout_constraintTop_toTopOf="@id/image_plant"
            app:layout_constraintEnd_toEndOf="@id/image_plant"
            android:layout_margin="6dp" />

        <!-- Plant name -->
        <TextView
            android:id="@+id/text_plant_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/gray_900"
            android:maxLines="1"
            android:ellipsize="end"
            android:paddingHorizontal="8dp"
            android:paddingTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/image_plant"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Plant category -->
        <TextView
            android:id="@+id/text_plant_category"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/gray_500"
            android:maxLines="1"
            android:ellipsize="end"
            android:paddingHorizontal="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="10dp"
            app:layout_constraintTop_toBottomOf="@id/text_plant_name"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
