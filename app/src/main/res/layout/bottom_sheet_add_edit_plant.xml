<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:paddingBottom="32dp">

    <!-- Handle bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@color/gray_300"
        android:layout_marginBottom="20dp" />

    <!-- Title -->
    <TextView
        android:id="@+id/text_sheet_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title_add_plant"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/gray_900"
        android:layout_marginBottom="20dp" />

    <!-- Plant name -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layout_name"
        style="@style/Widget.RootShare.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/label_plant_name"
        app:placeholderText="@string/hint_plant_name"
        android:layout_marginBottom="12dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edit_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapWords"
            android:imeOptions="actionNext" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Species (dropdown) -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layout_species"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/label_plant_species"
        android:layout_marginBottom="12dp">

        <AutoCompleteTextView
            android:id="@+id/edit_species"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none"
            android:imeOptions="actionNext" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Image URL (optional) -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layout_image_url"
        style="@style/Widget.RootShare.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/label_image_url"
        app:placeholderText="@string/hint_image_url"
        app:helperText="@string/hint_image_url_optional"
        app:helperTextEnabled="true"
        android:layout_marginBottom="12dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edit_image_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textUri"
            android:imeOptions="actionNext" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Status (edit mode only) -->
    <TextView
        android:id="@+id/label_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_status"
        android:textSize="13sp"
        android:textColor="@color/gray_600"
        android:visibility="gone"
        android:layout_marginBottom="8dp" />

    <RadioGroup
        android:id="@+id/radio_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone"
        android:layout_marginBottom="20dp">

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/radio_active"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Active"
            android:layout_marginEnd="12dp" />

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/radio_dead"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dead"
            android:layout_marginEnd="12dp" />

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/radio_gifted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gifted" />

    </RadioGroup>

    <!-- Error message -->
    <TextView
        android:id="@+id/text_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/colorError"
        android:textSize="13sp"
        android:visibility="gone"
        android:layout_marginBottom="12dp" />

    <!-- Submit button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_submit"
        style="@style/Widget.RootShare.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_add_plant" />

    <!-- Loading indicator -->
    <ProgressBar
        android:id="@+id/progress_submit"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center_horizontal"
        android:indeterminateTint="@color/emerald_500"
        android:visibility="gone"
        android:layout_marginTop="8dp" />

</LinearLayout>
