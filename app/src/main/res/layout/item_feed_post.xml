<?xml version="1.0" encoding="utf-8"?>
<!--
    Community feed post card — displayed in the vertical RecyclerView on the Home screen.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/gray_200"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Author avatar circle (40dp) -->
        <FrameLayout
            android:id="@+id/avatar_container"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <!-- Fallback: letter initial shown when no profile image -->
            <TextView
                android:id="@+id/text_author_initial"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:background="@drawable/bg_avatar_circle" />

            <!-- Profile image (loaded by Glide, hidden when no URL) -->
            <ImageView
                android:id="@+id/image_author_avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="@string/cd_profile_picture"
                android:visibility="gone" />

        </FrameLayout>

        <!-- Author username — vertically centered next to the avatar -->
        <TextView
            android:id="@+id/text_author_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/gray_900"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginStart="10dp"
            app:layout_constraintTop_toTopOf="@id/avatar_container"
            app:layout_constraintBottom_toBottomOf="@id/avatar_container"
            app:layout_constraintStart_toEndOf="@id/avatar_container"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Post type badge (Update / Swap / Giveaway) -->
        <TextView
            android:id="@+id/text_post_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/emerald_500"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            app:layout_constraintTop_toBottomOf="@id/avatar_container"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="8dp" />

        <!-- Associated plant name (optional) -->
        <TextView
            android:id="@+id/text_plant_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/emerald_600"
            android:textStyle="italic"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/text_post_type"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="6dp" />

        <!-- Post content -->
        <TextView
            android:id="@+id/text_content"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/gray_800"
            android:maxLines="4"
            android:ellipsize="end"
            app:layout_constraintTop_toBottomOf="@id/text_plant_name"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="6dp" />

        <!-- Post image (shown only when images exist) -->
        <ImageView
            android:id="@+id/image_post"
            android:layout_width="0dp"
            android:layout_height="180dp"
            android:scaleType="centerCrop"
            android:contentDescription="@string/cd_post_image"
            android:background="@color/gray_100"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/text_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp" />

        <!-- Footer: like button | comments | timestamp -->
        <ImageButton
            android:id="@+id/btn_like"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_like_post"
            app:layout_constraintTop_toBottomOf="@id/image_post"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="10dp" />

        <TextView
            android:id="@+id/text_likes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/gray_500"
            app:layout_constraintTop_toTopOf="@id/btn_like"
            app:layout_constraintBottom_toBottomOf="@id/btn_like"
            app:layout_constraintStart_toEndOf="@id/btn_like"
            android:layout_marginStart="4dp" />

        <TextView
            android:id="@+id/text_comments"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/gray_500"
            app:layout_constraintTop_toTopOf="@id/btn_like"
            app:layout_constraintBottom_toBottomOf="@id/btn_like"
            app:layout_constraintStart_toEndOf="@id/text_likes"
            android:layout_marginStart="16dp" />

        <TextView
            android:id="@+id/text_timestamp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/gray_400"
            android:gravity="end"
            app:layout_constraintTop_toTopOf="@id/btn_like"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/btn_like" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
