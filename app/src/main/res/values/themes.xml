<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Base application theme.
        Inherits from MaterialComponents so every widget (TextInputLayout,
        Button, BottomNavigationView, etc.) uses the Material Design system
        out-of-the-box without extra styling on each widget.
    -->
    <style name="Theme.RootShareMobile" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand colour -->
        <item name="colorPrimary">@color/emerald_500</item>
        <item name="colorPrimaryVariant">@color/emerald_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary / accent -->
        <item name="colorSecondary">@color/emerald_400</item>
        <item name="colorSecondaryVariant">@color/emerald_600</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Backgrounds & surfaces -->
        <item name="android:colorBackground">@color/colorBackground</item>
        <item name="colorSurface">@color/colorSurface</item>
        <!-- Status bar -->
        <item name="android:statusBarColor">@color/emerald_600</item>
    </style>

    <!-- Filled primary button style (used across all screens) -->
    <style name="Widget.RootShare.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/emerald_500</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <!-- Outlined secondary button style (e.g. "Continue with Google") -->
    <style name="Widget.RootShare.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/gray_300</item>
        <item name="android:textColor">@color/gray_700</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <!-- TextInputLayout (outlined) used for form fields -->
    <style name="Widget.RootShare.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/emerald_500</item>
        <item name="hintTextColor">@color/emerald_600</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>

    <!-- Section header text style -->
    <style name="TextAppearance.RootShare.SectionHeader" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textColor">@color/gray_900</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">18sp</item>
    </style>
</resources>
